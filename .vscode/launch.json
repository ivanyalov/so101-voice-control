{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Voice: Whisper -> Grok (Enter)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build/dev.py",
      "args": [
        "voice-toggle",
        "--terminal",
        "--max-seconds",
        "90"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Voice: Whisper -> Grok (shortcut)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build/dev.py",
      "args": [
        "voice-toggle"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Speech environment",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build/dev.py",
      "args": [
        "doctor"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Offline basic voice",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build/dev.py",
      "args": [
        "voice-toggle",
        "--terminal",
        "--planner",
        "basic"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
