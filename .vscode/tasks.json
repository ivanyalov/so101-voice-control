{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Voice: Whisper -> Grok (Enter)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/build/dev.py",
        "voice-toggle",
        "--terminal",
        "--max-seconds",
        "90"
      ],
      "problemMatcher": []
    },
    {
      "label": "Voice: Whisper -> Grok (shortcut)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/build/dev.py",
        "voice-toggle"
      ],
      "problemMatcher": []
    },
    {
      "label": "Speech environment",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/build/dev.py",
        "doctor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Offline basic voice",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/build/dev.py",
        "voice-toggle",
        "--terminal",
        "--planner",
        "basic"
      ],
      "problemMatcher": []
    }
  ]
}
