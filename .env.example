# Copy to .env and fill in your xAI credentials.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_REASONING_EFFORT=none
WHISPER_MODEL_PATH=models/whisper/ggml-tiny.en-q5_1.bin
TTS_VOICE=Samantha

# Optional Cyberwave client. Fill these in to use an existing paired twin.
CYBERWAVE_API_KEY=
CYBERWAVE_TWIN_UUID=
CYBERWAVE_WORKSPACE_ID=
# Blank key and workspace fall back to credentials.json and environment.json here.
# The directory defaults to ~/.cyberwave.
# CYBERWAVE_EDGE_CONFIG_DIR=/absolute/path/to/.cyberwave
