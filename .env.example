# Copy to .env, then fill in XAI_API_KEY and XAI_MODEL locally.
# Grok 4.3 supports structured JSON; reasoning is disabled for low latency.

# Grok: fill in these two values locally.
XAI_API_KEY=
XAI_MODEL=grok-4.3
# No extended reasoning for short command interpretation.
XAI_REASONING_EFFORT=none

# Local Whisper: already configured. Audio is transcribed on this Mac.
WHISPER_MODEL_PATH=models/whisper/ggml-tiny.en-q5_1.bin

# Optional local voice output. Spoken replies stay off unless --speak is used.
TTS_VOICE=Samantha

# Optional camera settings for camera-enabled previews.
CW_CAMERA_INDEX=0
CW_CAMERA_WIDTH=1280
CW_CAMERA_HEIGHT=720

# Future Cyberwave platform connection. Leave credentials empty for the current Grok preview.
# CW_MODE is an upstream setting; our launcher has no robot executor.
CYBERWAVE_API_KEY=
CYBERWAVE_TWIN_ID=
CYBERWAVE_ENVIRONMENT_ID=
CW_MODE=simulation
